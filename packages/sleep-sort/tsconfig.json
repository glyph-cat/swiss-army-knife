{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "importHelpers": false,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "stripInternal": true,
    "target": "ES2020",
  },
  "exclude": [
    "node_modules",
    "./src/**/*.draft*",
    "./src/**/*.old*",
    "**/*.test.*",
  ],
  "include": [
    "./src",
  ],
}