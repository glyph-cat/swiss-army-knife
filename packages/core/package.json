  "devDependencies": {
    "@glyph-cat/custom-tools": "workspace:*",
    "@glyph-cat/eslint-config": "workspace:*",
    "@glyph-cat/project-helpers": "workspace:*",
    "@rollup/plugin-babel": "~7.0.0",
    "@jest/types": "~30.4.1",
    "@microsoft/api-extractor": "~7.58.12",
    "@rollup/plugin-commonjs": "~29.0.3",
    "@rollup/plugin-node-resolve": "~16.0.3",
    "@rollup/plugin-typescript": "~12.3.0",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@types/jest": "~30.0.0",
    "@types/luxon": "~3.7.4",
    "@types/node": "~26.2.0",
    "eslint": "~10.8.1",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-functional": "~10.0.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jest": "~29.16.1",
    "eslint-plugin-jest-extended": "~3.0.1",
    "globals": "~17.11.0",
    "jest": "~30.4.2",
    "jest-extended": "~7.0.0",
    "jiti": "~2.7.0",
    "luxon": "~3.7.2",
    "react-native": "~0.87.0",
    "rollup": "~4.62.4",
    "tsx": "~4.23.12"
