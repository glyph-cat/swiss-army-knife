{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "./temp/tsc/types",
    "esModuleInterop": true,
    "importHelpers": false,
    "isolatedModules": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./temp/tsc/js",
    "rootDir": "..",
    // TODO: This would allow imports to be directly linked to source code
    // but rpt2 would complain that some dependencies of '@glyph-cat/css-utils'
    // could not be found (eg: csstype)
    // "paths": {
    //   "@glyph-cat/css-utils": [
    //     "../css-utils/src",
    //   ],
    // },
    "skipLibCheck": true,
    "strict": true,
    "stripInternal": true,
    "target": "ES2019",
    "types": [
      "node",
    ],
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "./src/**/*.draft*",
    "./src/**/*.old*",
    "**/*.test.*",
  ],
  "include": [
    "./custom.d.ts",
    "./src",
  ]
}