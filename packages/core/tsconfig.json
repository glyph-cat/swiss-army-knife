{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "importHelpers": false,
    "isolatedModules": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "paths": {
      "@glyph-cat/color": [
        "../color/src",
      ],
      "@glyph-cat/css-utils": [
        "../css-utils/src",
      ],
      "@glyph-cat/equality": [
        "../equality/src",
      ],
      "@glyph-cat/foundation": [
        "../foundation/src",
      ],
      "@glyph-cat/type-checking": [
        "../type-checking/src",
      ],
    },
    "skipLibCheck": true,
    "strict": true,
    "stripInternal": true,
    "target": "esnext",
    "types": [
      "jest",
      "node",
    ],
  },
}