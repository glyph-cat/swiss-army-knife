{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": [
      "jest",
      "node",
    ],
    "importHelpers": false,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // "paths": {
    //   // Used in Rollup config
    //   "@glyph-cat/foundation": [
    //     "../foundation/src",
    //   ],
    // },
    "rootDir": "..",
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "stripInternal": true,
    "target": "ES2020",
  },
  "exclude": [
    "node_modules",
    "**/*.draft*",
    "**/*.old*",
    "**/*.scripted*",
    "**/*.test.*",
  ],
  "include": [
    "./src",
    "./custom.d.ts"
  ],
}