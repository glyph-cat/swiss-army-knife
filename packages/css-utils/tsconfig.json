{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "importHelpers": false,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@glyph-cat/foundation": [
        "../foundation/src",
      ],
      "@glyph-cat/type-checking": [
        "../type-checking/src",
      ],
    },
    "rootDir": "..",
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "stripInternal": true,
    "target": "ES2020",
    "types": [
      "jest",
      "node",
    ],
  },
}