{
  "name": "@glyph-cat/react-test-utils",
  "version": "0.10.0",
  "description": "Helper functions for writing tests for React with Jest and @testing-library/react.",
  "main": "lib/cjs/index.js",
  "module": "lib/es/index.js",
  "files": [
    "lib"
  ],
  "types": "lib/types/index.d.ts",
  "scripts": {
    "clean": "rm -rf ./lib ./temp && mkdir temp lib",
    "afe": "tsx ./scripts/run/auto-forward-exports",
    "lint": "eslint .",
    "test": "jest -c ./jest.config.ts",
    "bundle": "rollup -c ./config/rollup.config.js",
    "types": "tsc --declaration",
    "api": "api-extractor run -c ./config/api-extractor.json --local --verbose",
    "build": "sh ./scripts/run/build.sh",
    "all": "sh ./scripts/run/all.sh"
  },
  "keywords": [
    "React",
    "Test",
    "Jest",
    "React Test Renderer"
  ],
  "author": "glyph-cat",
  "readme": "README.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/glyph-cat/swiss-army-knife.git"
  },
  "bugs": {
    "url": "https://github.com/glyph-cat/swiss-army-knife/issues"
  },
  "homepage": "https://github.com/glyph-cat/swiss-army-knife/tree/main/src/packages/react-test-utils#readme",
  "dependencies": {
    "@glyph-cat/cleanup-manager": "workspace:*",
    "@glyph-cat/foundation": "workspace:*",
    "@glyph-cat/swiss-army-knife": "workspace:*",
    "@glyph-cat/type-checking": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@glyph-cat/custom-tools": "workspace:*",
    "@glyph-cat/project-helpers": "workspace:*",
    "@types/react": "~19.2.14",
    "jest": "~30.3.0",
    "rollup": "~4.62.4",
    "@jest/types": "~30.4.1",
    "@microsoft/api-extractor": "~7.58.12",
    "@rollup/plugin-commonjs": "~29.0.3",
    "@rollup/plugin-node-resolve": "~16.0.3",
    "@rollup/plugin-typescript": "~12.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "~26.2.0",
    "eslint": "~10.8.1",
    "globals": "~17.11.0",
    "jest-extended": "~7.0.0",
    "tsx": "~4.23.12"
  }
}
