{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "./temp/tsc/types",
    "esModuleInterop": true,
    "importHelpers": false,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./temp/tsc/js",
    "paths": {
      "@glyph-cat/cleanup-manager": [
        "../cleanup-manager/src",
      ],
      // "@glyph-cat/color": [
      //   "../color/src",
      // ],
      "@glyph-cat/foundation": [
        "../foundation/src",
      ],
      "@glyph-cat/swiss-army-knife": [
        "../core/src",
      ],
      "@glyph-cat/type-checking": [
        "../type-checking/src",
      ],
    },
    "resolveJsonModule": true,
    "rootDir": "..",
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "jsx": "react-jsx",
    "stripInternal": true,
    "target": "ESNext",
    "types": [
      "jest",
      "node",
    ],
  },
  "exclude": [
    "node_modules",
    "**/*.draft*",
    "**/*.old*",
    "**/*.scripted*",
    "**/*.test*",
  ],
  "include": [
    "src",
  ]
}