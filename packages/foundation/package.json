{
  "name": "@glyph-cat/foundation",
  "version": "0.0.0-experimental.90",
  "main": "lib/cjs/index.js",
  "module": "lib/es/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "assets",
    "lib"
  ],
  "description": "GlyphCat's base constants, type definitions and other structures.",
  "author": "glyph-cat",
  "license": "MIT",
  "readme": "README.md",
  "scripts": {
    "clean": "rm -rf .cache ./dist ./lib ./temp",
    "afe": "tsx ./scripts/run/auto-forward-exports",
    "lint": "eslint .",
    "bundle": "rollup -c ./config/rollup.config.js",
    "test": "jest -c jest.config.ts",
    "types": "tsc --declaration",
    "api": "api-extractor run -c ./config/api-extractor.json --local --verbose",
    "build": "sh ./scripts/run/build.sh",
    "prepack": "tsx ./scripts/run/sync-package",
    "all": "sh ./scripts/run/all.sh"
  },
  "keywords": [
    "common constants",
    "common type definitions",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/glyph-cat/swiss-army-knife/tree/main/src/packages/foundation#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/glyph-cat/swiss-army-knife.git"
  },
  "bugs": {
    "url": "https://github.com/glyph-cat/swiss-army-knife/issues"
  },
  "devDependencies": {
    "@glyph-cat/custom-tools": "workspace:*",
    "@glyph-cat/project-helpers": "workspace:*",
    "@jest/types": "~30.3.0",
    "@microsoft/api-extractor": "~7.58.7",
    "@rollup/plugin-commonjs": "~29.0.2",
    "@rollup/plugin-node-resolve": "~16.0.3",
    "jest-extended": "~7.0.0",
    "rollup": "~4.60.2",
    "tsx": "~4.21.0",
    "@rollup/plugin-typescript": "~12.3.0"
  }
}
