{
  "name": "@glyph-cat/cli-parameter-parser",
  "version": "1.2.0",
  "description": "A simple parameter parser for NodeJS CLI applications.",
  "main": "lib/cjs/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "afe": "tsx ./scripts/run/auto-forward-exports",
    "lint": "eslint .",
    "test": "jest -c jest.config.ts",
    "bundle": "rollup -c ./config/rollup.config.js",
    "types": "tsc --declaration",
    "api": "api-extractor run -c ./config/api-extractor.json --local --verbose",
    "build": "sh scripts/run/build.sh",
    "all": "sh scripts/run/all.sh"
  },
  "keywords": [
    "CLI",
    "Command line",
    "Parameter",
    "Arguments",
    "Parser"
  ],
  "author": "glyph-cat",
  "readme": "README.md",
  "license": "MIT",
  "homepage": "https://github.com/glyph-cat/swiss-army-knife/tree/main/src/packages/cli-parameter-parser#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/glyph-cat/swiss-army-knife.git"
  },
  "bugs": {
    "url": "https://github.com/glyph-cat/swiss-army-knife/issues"
  },
  "dependencies": {
    "@glyph-cat/foundation": "workspace:*"
  },
  "devDependencies": {
    "@glyph-cat/eslint-config": "workspace:*",
    "@glyph-cat/project-helpers": "workspace:*",
    "jest": "~30.3.0",
    "@glyph-cat/custom-tools": "workspace:*",
    "rollup": "~4.62.4",
    "@jest/types": "~30.4.1",
    "@microsoft/api-extractor": "~7.58.12",
    "@rollup/plugin-commonjs": "~29.0.3",
    "@rollup/plugin-node-resolve": "~16.0.3",
    "@rollup/plugin-typescript": "~12.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "~26.2.0",
    "eslint": "~10.8.1",
    "globals": "~17.11.0",
    "jest-extended": "~7.0.0",
    "tsx": "~4.23.12"
  }
}
